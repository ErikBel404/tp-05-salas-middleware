<section class="max-w-lg mx-auto bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm">
   <div class="mb-6">
      <p class="text-xs font-semibold uppercase tracking-wider text-indigo-600 mb-1">
         <%= locals.seccion ?? 'Reservas de salas' %>
      </p>
      <h1 class="text-2xl font-bold text-slate-900">
         <%= titulo %>
      </h1>
   </div>

   <% if (error) { %>
      <div
         class="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-lg text-sm mb-6 flex items-start gap-2"
         role="alert">
         <span class="font-bold">Error:</span>
         <span>
            <%= error %>
         </span>
      </div>
      <% } %>

         <form action="/reservas" method="post" class="space-y-5" novalidate>
            
            <!-- Nombre del estudiante -->
            <div>
               <label for="estudiante" class="block text-sm font-medium text-slate-700 mb-1">Nombre completo del
                  estudiante</label>
               <input type="text" id="estudiante" name="estudiante" value="<%= valores.estudiante ?? '' %>"
                  placeholder="Ej: Sofía Peralta"
                  class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors">
            </div>

            <!-- Correo electrónico -->
            <div>
               <label for="email" class="block text-sm font-medium text-slate-700 mb-1">Correo electrónico</label>
               <input type="email" id="email" name="email" value="<%= valores.email ?? '' %>"
                  placeholder="usuario@campus.edu.ar"
                  class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors">
            </div>

            <!-- Sala de estudio -->
            <div>
               <label for="sala" class="block text-sm font-medium text-slate-700 mb-1">Sala solicitada</label>
               <select id="sala" name="sala"
                  class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors">
                  <option value="" disabled <%=!valores.sala ? 'selected' : '' %>>Seleccione una sala</option>
                  <% salasPermitidas.forEach((opcion)=> { %>
                     <option value="<%= opcion %>" <%=valores.sala===opcion ? 'selected' : '' %>>
                        <%= opcion %>
                     </option>
                     <% }) %>
               </select>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
               <!-- Fecha -->
               <div>
                  <label for="fecha" class="block text-sm font-medium text-slate-700 mb-1">Fecha</label>
                  <input type="date" id="fecha" name="fecha" value="<%= valores.fecha ?? '' %>"
                     class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors">
               </div>

               <!-- Turno -->
               <div>
                  <label for="turno" class="block text-sm font-medium text-slate-700 mb-1">Turno</label>
                  <select id="turno" name="turno"
                     class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors">
                     <option value="" disabled <%=!valores.turno ? 'selected' : '' %>>Seleccione turno</option>
                     <% turnosPermitidos.forEach((opcion)=> { %>
                        <option value="<%= opcion %>" <%=valores.turno===opcion ? 'selected' : '' %>>
                           <%= opcion %>
                        </option>
                        <% }) %>
                  </select>
               </div>
            </div>

            <!-- Cantidad de personas -->
            <div>
               <label for="personas" class="block text-sm font-medium text-slate-700 mb-1">Cantidad de personas (1 a
                  6)</label>
               <input type="number" id="personas" name="personas" min="1" max="6" value="<%= valores.personas ?? '' %>"
                  placeholder="1"
                  class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors">
            </div>

            <div class="pt-3 flex items-center justify-end gap-3">
               <a href="/reservas"
                  class="px-4 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-800 transition-colors">
                  Cancelar
               </a>
               <button type="submit"
                  class="px-5 py-2.5 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-colors cursor-pointer">
                  Registrar reserva
               </button>
            </div>
         </form>
</section>