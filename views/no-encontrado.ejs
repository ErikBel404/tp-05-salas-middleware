<section class="max-w-md mx-auto text-center py-16 px-4">
   <span
      class="inline-block text-xs font-bold tracking-widest text-rose-600 uppercase bg-rose-50 px-3 py-1 rounded-full mb-3">
      Error 404
   </span>
   <h1 class="text-3xl font-extrabold text-slate-900 mb-3">
      <%= titulo %>
   </h1>
   <p class="text-slate-600 mb-8 leading-relaxed">
      <%= mensaje %>
   </p>
   <div class="flex justify-center gap-3">
      <a href="/reservas"
         class="px-4 py-2.5 rounded-md text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors">
         Volver al Listado
      </a>
      <a href="/"
         class="px-4 py-2.5 rounded-md text-sm font-medium text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-colors">
         Ir al Inicio
      </a>
   </div>
</section>